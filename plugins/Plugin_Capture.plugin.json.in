{
  "schemaVersion": 2,
  "abiVersion": 1,
  "id": "capture",
  "name": "Capture",
  "version": "@PROJECT_VERSION@",
  "minimumHostVersion": "1.0.0",
  "entryPoint": "CreatePlugin",
  "executionModel": "trusted-native-in-process",
  "capabilities": ["screenshot", "annotation", "scroll-capture", "recording", "recording-audio", "ocr", "pin"],
  "permissions": ["screen-capture", "system-audio", "microphone", "clipboard", "file-write", "global-hotkey"]
}
