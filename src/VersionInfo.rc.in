#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @TOOLS3000_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Yy1 (GitHub yuan278501381)\0"
            VALUE "FileDescription", "@TOOLS3000_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "@TARGET@\0"
            VALUE "LegalCopyright", "Copyright (C) @TOOLS3000_COPYRIGHT_YEAR@ Yy1 (GitHub yuan278501381) <https://github.com/yuan278501381> & Tools3000 contributors\0"
            VALUE "LegalTrademarks", "Tools3000 by Yy1 (GitHub yuan278501381)\0"
            VALUE "OriginalFilename", "@TOOLS3000_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "Tools3000\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
