// ─────────────────────────────────────────────────────────────────────────────
// ui/icons.slint — 纯矢量 Lucide SVG 图标原语（100% 零 Emoji，支持任意高分屏缩放）
// ─────────────────────────────────────────────────────────────────────────────

export component VectorIcon inherits Rectangle {
    in property <string> path-data;
    in property <color> icon-color: #52525b;
    in property <length> icon-size: 16px;
    in property <float> stroke-w: 1.85;
    in property <bool> filled: false;

    width: root.icon-size;
    height: root.icon-size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.icon-color;
        stroke-width: root.stroke-w * 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.icon-color : transparent;
        commands: root.path-data;
    }
}

