// ─────────────────────────────────────────────────────────────────────────────
// ui/quick_switch.slint — Quick Switch v2（1:1 对标 vibeslop/AltTabio 浅色/深色极简美学）
//                         + Tools3000 动态主题色 + 8 向自由缩放 + 分割线拖拽 + 中文拼音搜索
// ─────────────────────────────────────────────────────────────────────────────

import { ThemeTokens } from "tokens.slint";
import { VectorIcon, LucidePaths } from "icons.slint";

export struct QuickSwitchRowItem {
    index: int,
    title: string,
    app-name: string,
    icon: image,
    has-icon: bool,
    number-label: string,
    is-minimized: bool,
    is-pinned: bool,
    is-tray: bool,
    state-badge: string,
}

export component QuickSwitchWindow inherits Window {
    title: "Tools3000_WindowKit_QuickSwitch";
    no-frame: true;
    always-on-top: true;
    background: ThemeTokens.qs-bg;
    default-font-family: ThemeTokens.font-family;
    preferred-width: 1120px;
    preferred-height: 660px;

    in-out property <[QuickSwitchRowItem]> items: [];
    in-out property <int> selected-index: 0;
    in-out property <string> filter-text: "";
    in-out property <bool> search-visible: true;
    in-out property <bool> search-locked: false;
    in-out property <bool> show-numbers: true;
    in-out property <bool> show-app-names: false;
    in-out property <bool> compact-list: false;
    in-out property <bool> same-app-mode: false;
    in-out property <string> scope-title: "";
    in-out property <string> search-placeholder: "搜索窗口 / 拼音首字母 · 1-9 直达";
    in-out property <string> empty-label: "没有匹配的窗口";
    in-out property <string> preview-unavailable-hint: "窗口已最小化或收纳至托盘，按 Enter 立即恢复";
    in-out property <bool> preview-has-live-thumb: true;
    in-out property <string> selected-title: "";
    in-out property <string> selected-app-name: "";
    in-out property <image> selected-icon;
    in-out property <bool> selected-has-icon: false;
    in-out property <bool> selected-is-pinned: false;
    in-out property <float> list-width-ratio: 0.30;

    // 交互回调
    callback select-row(int);
    callback activate-row(int);
    callback close-row(int);
    callback filter-changed(string);
    callback clear-filter();
    callback search-engaged();
    callback action-requested(string); // "pin" | "maximize" | "minimize" | "tray" | "close" | "kill" | "new"
    callback key-command(string, bool, bool); // key-name, shift, ctrl
    callback dismiss-requested();
    callback drag-move-requested();
    callback drag-resize-requested(int); // 1=N,2=S,3=W,4=E,5=NW,6=NE,7=SW,8=SE
    callback list-ratio-changed(float);
    callback preview-slot-changed(float, float, float, float);

    property <length> row-h: root.compact-list ? 40px : 48px;
    property <length> row-stride: root.row-h + 5px;
    property <length> selected-row-top: max(0, root.selected-index) * root.row-stride;
    property <length> selected-row-bottom: root.selected-row-top + root.row-h;
    property <length> computed-list-w: clamp(root.width * root.list-width-ratio, 230px, max(230px, root.width - 280px));
    property <length> preview-x: root.computed-list-w + 1px;
    property <length> preview-w: max(120px, root.width - root.preview-x);

    // 预览槽位变更时自动回传给 Rust 原生层刷新 DwmRegisterThumbnail 精准落位
    changed width => {
        root.preview-slot-changed(root.preview-x / 1px, 0, root.preview-w / 1px, root.height / 1px);
    }
    changed height => {
        root.preview-slot-changed(root.preview-x / 1px, 0, root.preview-w / 1px, root.height / 1px);
        root.ensure-selected-visible();
    }
    changed list-width-ratio => {
        root.preview-slot-changed(root.preview-x / 1px, 0, root.preview-w / 1px, root.height / 1px);
    }
    changed selected-index => {
        root.ensure-selected-visible();
    }

    public function focus-input() {
        search-input.focus();
    }

    public function ensure-selected-visible() {
        if (root.items.length <= 0 || list-flick.height <= 0px) {
            list-flick.content-y = 0px;
            return;
        }
        if (root.selected-row-top < -list-flick.content-y) {
            list-flick.content-y = -root.selected-row-top;
        } else if (root.selected-row-bottom > (-list-flick.content-y + list-flick.height)) {
            list-flick.content-y = list-flick.height - root.selected-row-bottom;
        }
        if (list-flick.content-y > 0px) {
            list-flick.content-y = 0px;
        }
        if (list-flick.content-y < min(0px, list-flick.height - list-flick.content-height)) {
            list-flick.content-y = min(0px, list-flick.height - list-flick.content-height);
        }
    }

    public function notify-preview-slot() {
        root.preview-slot-changed(root.preview-x / 1px, 0, root.preview-w / 1px, root.height / 1px);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: ThemeTokens.qs-bg;
        border-width: 1px;
        border-color: ThemeTokens.qs-border;
        border-radius: 8px;
        clip: true;

        // 空白处拖动移动整个窗口（Windows winit 中 pointer 映射为标准 IDC_HAND 手型光标，明确反馈可拖动）
        TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: pointer;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-move-requested();
                }
            }
        }

        // ── 左栏：AltTabio 极简舒展窗口列表 + 按需显现底部搜索胶囊 ───────────
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.computed-list-w;
            height: parent.height;
            background: transparent;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 8px;

                // 仅同应用模式 (Alt+`) 显示一行克制标识，常规全局 Alt+Tab 保持 100% 零顶栏杂讯
                if root.same-app-mode && root.scope-title != "" : HorizontalLayout {
                    height: 24px;
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        height: 22px;
                        border-radius: 6px;
                        background: ThemeTokens.accent-soft-bg;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 5px;
                            alignment: center;

                            VectorIcon {
                                path-data: LucidePaths.layers;
                                icon-size: 13px;
                                icon-color: ThemeTokens.accent;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.scope-title;
                                font-size: 12px;
                                font-weight: 600;
                                color: ThemeTokens.accent;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // 主滚动窗口列表
                list-flick := Flickable {
                    vertical-stretch: 1;
                    content-height: max(self.height, root.items.length * root.row-stride);

                    // 列表下方留白区域同样呈现手型光标并支持拖拽移动窗口
                    TouchArea {
                        width: parent.width;
                        height: parent.content-height;
                        mouse-cursor: pointer;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.drag-move-requested();
                            }
                        }
                    }

                    if root.items.length == 0 : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        Text {
                            text: root.empty-label;
                            color: ThemeTokens.text-muted;
                            font-size: 14px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for item[idx] in root.items : Rectangle {
                        x: 0px;
                        y: idx * (root.row-h + 5px);
                        width: parent.width;
                        height: root.row-h;
                        border-radius: 8px;
                        background: idx == root.selected-index
                            ? ThemeTokens.qs-selected-bg
                            : (row-ta.has-hover ? ThemeTokens.qs-hover-bg : transparent);

                        animate background { duration: 110ms; easing: ease-out; }

                        row-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => {
                                root.activate-row(idx);
                            }
                            moved => {
                                if (idx != root.selected-index) {
                                    root.select-row(idx);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 10px;
                            alignment: stretch;

                            // 1-9 微晶圆角编号键帽（清晰直观，按下 1-9 或 Alt+1-9 毫秒直达）
                            if root.show-numbers && item.number-label != "" : Rectangle {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: idx == root.selected-index
                                    ? ThemeTokens.qs-keycap-active-bg
                                    : ThemeTokens.qs-keycap-bg;
                                border-width: 1px;
                                border-color: idx == root.selected-index
                                    ? ThemeTokens.accent-subtle-border
                                    : ThemeTokens.qs-keycap-border;

                                Text {
                                    text: item.number-label;
                                    color: idx == root.selected-index
                                        ? ThemeTokens.accent
                                        : ThemeTokens.text-secondary;
                                    font-size: 11.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // 真实 28px 彩色应用图标
                            Rectangle {
                                width: root.compact-list ? 24px : 28px;
                                height: root.compact-list ? 24px : 28px;
                                y: (parent.height - self.height) / 2;
                                background: item.has-icon ? transparent : ThemeTokens.qs-badge-bg;
                                border-radius: 6px;

                                if item.has-icon : Image {
                                    width: 100%;
                                    height: 100%;
                                    source: item.icon;
                                    image-fit: contain;
                                }
                            }

                            // 标题（与可选副标题）
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: item.title;
                                    color: ThemeTokens.text-primary;
                                    font-size: root.compact-list ? 13.5px : 15px;
                                    font-weight: idx == root.selected-index ? 600 : 500;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                if root.show-app-names && item.app-name != "" : Text {
                                    text: item.app-name;
                                    color: ThemeTokens.text-secondary;
                                    font-size: 12px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                            }

                            // 极简状态徽章（仅最小化/托盘/置顶时显示）
                            if item.state-badge != "" : Rectangle {
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: ThemeTokens.qs-badge-bg;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: item.state-badge;
                                        color: ThemeTokens.text-secondary;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 悬停时淡入极简关闭 × 按钮（1:1 AltTabio 交互，常驻元素避免条件自引用）
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 6px;
                                opacity: (row-ta.has-hover || close-ta.has-hover) ? 1.0 : 0.0;
                                background: close-ta.has-hover ? ThemeTokens.qs-close-hover : transparent;

                                animate opacity { duration: 100ms; easing: ease-out; }

                                VectorIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    path-data: LucidePaths.close;
                                    icon-size: 14px;
                                    icon-color: ThemeTokens.text-secondary;
                                }

                                close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    enabled: !item.is-tray;
                                    clicked => {
                                        root.close-row(idx);
                                    }
                                }
                            }
                        }
                    }
                }

                // 底部常驻极简搜索胶囊（常态柔和隐融，支持直接打字/中文拼音即输即滤与点击锁定）
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: (root.search-locked || root.filter-text != "" || search-input.has-focus)
                        ? ThemeTokens.qs-search-bg
                        : ThemeTokens.qs-search-idle-bg;
                    border-width: 1px;
                    border-color: (root.search-locked || root.filter-text != "")
                        ? ThemeTokens.accent-subtle-border
                        : ThemeTokens.border-strong;
                    clip: true;

                    animate border-color { duration: 120ms; easing: ease-out; }
                    animate background { duration: 120ms; easing: ease-out; }

                    // 点击搜索框任意处立即锁定搜索态并聚焦，避免松开 Alt 闪退
                    TouchArea {
                        mouse-cursor: text;
                        clicked => {
                            root.search-engaged();
                            search-input.focus();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        alignment: stretch;

                        VectorIcon {
                            y: (parent.height - self.height) / 2;
                            path-data: LucidePaths.search;
                            icon-size: 14px;
                            icon-color: (root.search-locked || root.filter-text != "")
                                ? ThemeTokens.accent
                                : ThemeTokens.text-muted;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 100%;
                            background: transparent;

                            if root.filter-text == "" : Text {
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: root.search-placeholder;
                                color: ThemeTokens.text-muted;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            search-input := TextInput {
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                text <=> root.filter-text;
                                color: ThemeTokens.text-primary;
                                font-size: 13.5px;
                                font-weight: 500;
                                vertical-alignment: center;
                                single-line: true;

                                edited => {
                                    root.filter-changed(self.text);
                                }

                                key-pressed(ev) => {
                                    if (ev.text == Key.UpArrow) {
                                        root.key-command("up", ev.modifiers.shift, ev.modifiers.control);
                                        return accept;
                                    }
                                    if (ev.text == Key.DownArrow) {
                                        root.key-command("down", ev.modifiers.shift, ev.modifiers.control);
                                        return accept;
                                    }
                                    if (ev.text == Key.Tab) {
                                        root.key-command("tab", ev.modifiers.shift, ev.modifiers.control);
                                        return accept;
                                    }
                                    if (ev.text == Key.Return) {
                                        root.key-command("enter", ev.modifiers.shift, ev.modifiers.control);
                                        return accept;
                                    }
                                    if (ev.text == Key.Escape) {
                                        root.key-command("escape", ev.modifiers.shift, ev.modifiers.control);
                                        return accept;
                                    }
                                    if (ev.text == Key.F4) {
                                        root.action-requested("close");
                                        return accept;
                                    }
                                    if (ev.text == Key.F5) {
                                        root.action-requested("minimize");
                                        return accept;
                                    }
                                    if (ev.text == Key.F6) {
                                        root.action-requested("maximize");
                                        return accept;
                                    }
                                    if (ev.text == Key.F7) {
                                        root.action-requested("restore");
                                        return accept;
                                    }
                                    if (ev.text == Key.F8) {
                                        root.action-requested("kill");
                                        return accept;
                                    }
                                    if (ev.text == Key.F9) {
                                        root.action-requested("new");
                                        return accept;
                                    }
                                    if (ev.text == Key.Delete && root.filter-text == "") {
                                        root.action-requested("close");
                                        return accept;
                                    }
                                    if (ev.modifiers.control && !ev.modifiers.alt) {
                                        if (ev.text == "p" || ev.text == "P") {
                                            root.action-requested("pin");
                                            return accept;
                                        }
                                        if (ev.text == "z" || ev.text == "Z") {
                                            root.action-requested("zone");
                                            return accept;
                                        }
                                        if (ev.text == "t" || ev.text == "T") {
                                            root.action-requested("tray");
                                            return accept;
                                        }
                                        if (ev.text == "d" || ev.text == "D") {
                                            root.action-requested("toggle_desktop_preview");
                                            return accept;
                                        }
                                        if (ev.text == "w" || ev.text == "W") {
                                            root.action-requested("close");
                                            return accept;
                                        }
                                    }
                                    // 空查询时单按 1-9，或任意时候按 Alt+1-9 / Ctrl+1-9，均直接跳转对应编号窗口
                                    if (ev.text >= "1" && ev.text <= "9"
                                        && (root.filter-text == "" || ev.modifiers.alt || ev.modifiers.control)) {
                                        root.key-command("digit_" + ev.text, ev.modifiers.shift, ev.modifiers.control);
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }

                        if root.filter-text == "" && root.show-numbers : Rectangle {
                            width: 30px;
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: ThemeTokens.qs-keycap-bg;
                            border-width: 1px;
                            border-color: ThemeTokens.qs-keycap-border;

                            Text {
                                text: "1-9";
                                color: ThemeTokens.text-muted;
                                font-size: 10.5px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.filter-text != "" : Rectangle {
                            width: 24px;
                            height: 24px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: clear-ta.has-hover ? ThemeTokens.btn-ghost-hover : transparent;

                            VectorIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                path-data: LucidePaths.close;
                                icon-size: 13px;
                                icon-color: ThemeTokens.text-muted;
                            }

                            clear-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.clear-filter();
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 可拖拽极细竖向分割线（1:1 AltTabio 发丝分隔，悬停提亮加宽便于抓取） ──
        Rectangle {
            x: (split-ta.has-hover || split-ta.pressed) ? root.computed-list-w - 0.5px : root.computed-list-w;
            y: 16px;
            width: (split-ta.has-hover || split-ta.pressed) ? 2px : 1px;
            height: max(1px, parent.height - 32px);
            border-radius: 1px;
            background: split-ta.has-hover || split-ta.pressed ? ThemeTokens.accent : ThemeTokens.qs-divider;
        }

        split-ta := TouchArea {
            x: root.computed-list-w - 4px;
            y: 0px;
            width: 9px;
            height: parent.height;
            mouse-cursor: col-resize;
            moved => {
                if (self.pressed && root.width > 400px) {
                    root.list-width-ratio = clamp((self.x + self.mouse-x) / root.width, 0.20, 0.52);
                    root.list-ratio-changed(root.list-width-ratio);
                }
            }
        }

        // ── 右栏：纯净留白 DWM 零拷贝实时窗口预览区（悬停呈现手型光标指示可拖动定位） ─
        preview-pane := Rectangle {
            x: root.preview-x;
            y: 0px;
            width: root.preview-w;
            height: parent.height;
            background: transparent;

            preview-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        root.drag-move-requested();
                    }
                }
                double-clicked => {
                    root.activate-row(root.selected-index);
                }
            }

            // 当窗口最小化/托盘收纳无法生成实时缩略图时，展示优雅极简占位卡片（拒绝大黑洞）
            if !root.preview-has-live-thumb && root.items.length > 0 : VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 36px;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 16px;
                    background: ThemeTokens.card-bg;
                    border-width: 1px;
                    border-color: ThemeTokens.border-subtle;
                    drop-shadow-blur: 14px;
                    drop-shadow-offset-y: 4px;
                    drop-shadow-color: ThemeTokens.card-shadow;

                    if root.selected-has-icon : Image {
                        width: 40px;
                        height: 40px;
                        x: 12px;
                        y: 12px;
                        source: root.selected-icon;
                        image-fit: contain;
                    }
                }

                Text {
                    text: root.selected-title;
                    color: ThemeTokens.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Text {
                    text: root.preview-unavailable-hint;
                    color: ThemeTokens.text-secondary;
                    font-size: 13px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // 鼠标悬停右栏底部时淡入的微晶快捷操作条（常态隐身不破坏 AltTabio 极简感）
            Rectangle {
                visible: root.items.length > 0;
                opacity: (preview-ta.has-hover || dock-ta.has-hover || btn-pin.has-hover || btn-min.has-hover || btn-max.has-hover || btn-tray.has-hover || btn-cls.has-hover) ? 1.0 : 0.0;
                width: 204px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: parent.height - 46px;
                border-radius: 10px;
                background: ThemeTokens.card-bg;
                border-width: 1px;
                border-color: ThemeTokens.border-strong;
                drop-shadow-blur: 14px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: ThemeTokens.modal-shadow;

                animate opacity { duration: 120ms; easing: ease-out; }

                dock-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: default;
                }

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;

                    // 置顶 (P)
                    Rectangle {
                        width: 34px;
                        height: 28px;
                        y: 4px;
                        border-radius: 6px;
                        background: root.selected-is-pinned
                            ? ThemeTokens.accent-soft-bg
                            : (btn-pin.has-hover ? ThemeTokens.btn-ghost-hover : transparent);
                        VectorIcon {
                            x: 9px; y: 6px; icon-size: 16px;
                            path-data: LucidePaths.pin;
                            icon-color: root.selected-is-pinned ? ThemeTokens.accent : ThemeTokens.text-secondary;
                        }
                        btn-pin := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.action-requested("pin"); }
                        }
                    }

                    // 最小化 (F5)
                    Rectangle {
                        width: 34px; height: 28px; y: 4px; border-radius: 6px;
                        background: btn-min.has-hover ? ThemeTokens.btn-ghost-hover : transparent;
                        VectorIcon {
                            x: 9px; y: 6px; icon-size: 16px;
                            path-data: LucidePaths.minus;
                            icon-color: ThemeTokens.text-secondary;
                        }
                        btn-min := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.action-requested("minimize"); }
                        }
                    }

                    // 最大化 (F6)
                    Rectangle {
                        width: 34px; height: 28px; y: 4px; border-radius: 6px;
                        background: btn-max.has-hover ? ThemeTokens.btn-ghost-hover : transparent;
                        VectorIcon {
                            x: 10px; y: 7px; icon-size: 14px;
                            path-data: LucidePaths.maximize;
                            icon-color: ThemeTokens.text-secondary;
                        }
                        btn-max := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.action-requested("maximize"); }
                        }
                    }

                    // 收纳至托盘 (T)
                    Rectangle {
                        width: 34px; height: 28px; y: 4px; border-radius: 6px;
                        background: btn-tray.has-hover ? ThemeTokens.btn-ghost-hover : transparent;
                        VectorIcon {
                            x: 9px; y: 6px; icon-size: 16px;
                            path-data: LucidePaths.tray;
                            icon-color: ThemeTokens.text-secondary;
                        }
                        btn-tray := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.action-requested("tray"); }
                        }
                    }

                    // 关闭窗口 (F4)
                    Rectangle {
                        width: 34px; height: 28px; y: 4px; border-radius: 6px;
                        background: btn-cls.has-hover ? ThemeTokens.danger-hover-bg : transparent;
                        VectorIcon {
                            x: 9px; y: 6px; icon-size: 16px;
                            path-data: LucidePaths.close;
                            icon-color: btn-cls.has-hover ? ThemeTokens.danger : ThemeTokens.text-secondary;
                        }
                        btn-cls := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.action-requested("close"); }
                        }
                    }
                }
            }
        }

        // ── 8 向隐形无边框自由缩放边缘热区（直接触发原生 OS 144Hz Resize） ──
        // Top / Bottom / Left / Right
        TouchArea {
            x: 10px; y: 0px; width: parent.width - 20px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(1);
                }
            }
        }
        TouchArea {
            x: 10px; y: parent.height - 5px; width: parent.width - 20px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(2);
                }
            }
        }
        TouchArea {
            x: 0px; y: 10px; width: 5px; height: parent.height - 20px;
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(3);
                }
            }
        }
        TouchArea {
            x: parent.width - 5px; y: 10px; width: 5px; height: parent.height - 20px;
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(4);
                }
            }
        }
        // Four Corners
        TouchArea {
            x: 0px; y: 0px; width: 10px; height: 10px;
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(5);
                }
            }
        }
        TouchArea {
            x: parent.width - 10px; y: 0px; width: 10px; height: 10px;
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(6);
                }
            }
        }
        TouchArea {
            x: 0px; y: parent.height - 10px; width: 10px; height: 10px;
            mouse-cursor: nesw-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(7);
                }
            }
        }
        TouchArea {
            x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px;
            mouse-cursor: nwse-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-resize-requested(8);
                }
            }
        }
    }
}
