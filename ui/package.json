{
  "name": "tools3000-ui",
  "version": "1.3.2",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "vite:build": "vite build && node scripts/check-production-html.js",
    "build:bundle": "tsc -b && vite build && node scripts/check-production-html.js",
    "build": "node scripts/run-static-gates.mjs && npm run build:bundle",
    "lint:eslint": "eslint . --cache --cache-location ./node_modules/.tmp/.eslintcache",
    "lint:gates": "node scripts/run-static-gates.mjs",
    "lint": "npm run lint:eslint && npm run lint:gates",
    "test": "vitest run",
    "preview": "vite preview",
    "i18n-check": "node scripts/check-i18n.js",
    "native-i18n-check": "node scripts/check-native-i18n.js",
    "logger-check": "node scripts/check-logger.js",
    "css-check": "node scripts/check-css-variables.js",
    "typography-check": "node scripts/check-typography.js",
    "trim-workingset-check": "node scripts/check-trim-workingset.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "undici": "^7.30.2",
    "source-map-js": "^1.2.4",
    "brace-expansion": "^5.0.13",
    "minimatch": "^11.0.9",
    "zod": "^4.6.6"
  }
}
